# PawVita API — copy to .env and fill in.
#
# With nothing set, the API runs fully locally: embedded Postgres (PGlite) in
# ./.data, a stand-in auth provider that prints OTPs to the log, and uploads on
# disk. Set the Supabase values below to use the real services.

NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Number of proxies in front of the API (1 behind a single load balancer).
TRUST_PROXY=0

# --- Supabase Postgres -------------------------------------------------------
# Project Settings → Database → Connection string. Use the session pooler
# (port 5432) or direct connection. For the transaction pooler (port 6543) also
# set DB_DISABLE_PREPARE=true.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DB_DISABLE_PREPARE=false
# DB_POOL_MAX=10
# Apply migrations on boot (default: on outside production). In production run `npm run db:migrate` in the deploy step.
# DB_MIGRATE_ON_START=true

# --- Supabase Auth + Storage -------------------------------------------------
# Project Settings → API Keys. The legacy names SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are accepted too.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# Only for projects still signing JWTs with the legacy shared secret (HS256).
# SUPABASE_JWT_SECRET=
# Private bucket for photos, voice notes and lab reports (created on first boot).
# SUPABASE_STORAGE_BUCKET=pawvita-uploads

# Providers default to "supabase" when the Supabase values are set, else "local".
# AUTH_PROVIDER=supabase
# STORAGE_PROVIDER=supabase

# --- Local development only --------------------------------------------------
# Accept this code for every phone number instead of a random one (handy for demos).
LOCAL_AUTH_FIXED_OTP=123456
# LOCAL_AUTH_JWT_SECRET=change-me-to-at-least-32-characters-long
# PGLITE_DIR=.data/pglite
# LOCAL_STORAGE_DIR=.data/uploads

# --- Features ----------------------------------------------------------------
# MAX_UPLOAD_MB=15
# JOBS_ENABLED=true
# JOBS_INTERVAL_MINUTES=60
# REMINDER_LOOKAHEAD_DAYS=7
# API calls per signed-in account (or per IP when signed out) per minute.
# RATE_LIMIT_PER_MINUTE=600
# Set to false to turn every rate limit off (they are always off in tests).
# RATE_LIMITS_ENABLED=true
# Base URL of the AI services once they exist. Unset → the AI hook does nothing.
# AI_SERVICE_URL=
