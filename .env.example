# PawVita frontend — copy to .env.local (git-ignored) and adjust.
# Every value is optional; the defaults suit `npm run dev` next to the local API.

# Where the API lives. Leave empty in development: Vite forwards /api to
# API_PROXY_TARGET. For a build served from another origin, set the API origin
# (and list this site's origin in the API's CORS_ORIGINS).
# VITE_API_URL=https://api.pawvita.in

# Where `npm run dev` and `npm run preview` forward /api.
# API_PROXY_TARGET=http://localhost:4000

# One-click demo sign-in on /login. On by default in development, off in builds.
# It signs in as the accounts from `npm run db:seed -- --demo` in server/.
# VITE_DEMO_ACCESS=true
# Password of the seeded demo accounts.
# VITE_DEMO_PASSWORD=PawVita@2026
